<Window
    x:Class="AdminConsole.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:viewModels="clr-namespace:AdminConsole.ViewModels"
    xmlns:views="clr-namespace:AdminConsole.Views"
    xmlns:converters="clr-namespace:AdminConsole.Converters"
    mc:Ignorable="d"
    Icon="pack://application:,,,/Resources/icon.ico"
    Title="Admin Console"
    Height="820" Width="1280"
    MinHeight="600" MinWidth="900"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    TextElement.FontFamily="{materialDesign:MaterialDesignFont}"
    TextElement.FontSize="13"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="Grayscale"
    TextOptions.TextHintingMode="Fixed"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    FontFamily="{materialDesign:MaterialDesignFont}"
    d:DataContext="{d:DesignInstance viewModels:MainViewModel,
                   IsDesignTimeCreatable=False}"
    StateChanged="Window_StateChanged"
    Closing="Window_Closing">
    
    <!--
        Typed DataTemplates — WPF автоматично знаходить шаблон по типу
        об'єкта в ContentControl.Content. Не потрібен x:Key.
        ContentControl встановлює DataContext = Content перед рендерингом,
        тому кожен UserControl отримує свій ViewModel автоматично.
    -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:PingDashboardViewModel}">
            <views:PingDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:UptimeViewModel}">
            <views:UptimeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ResourceMonitorViewModel}">
            <views:ResourceMonitorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RdpSessionViewModel}">
            <views:RdpSessionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ZabbixViewModel}">
            <views:ZabbixView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    </Window.Resources>

    <!--
        Корінь — звичайний Grid, прямий дочірній елемент Window.
        DataContext = MainViewModel успадковується без жодних перешкод.
        DialogHost відсутній — overlay реалізований нижче як Grid шар.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <SolidColorBrush Color="#FF263238" />
        </Grid.Background>

        <!-- ROW 0 — Header -->
        <Border Grid.Row="0" Background="#FF37474F" Padding="16,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Monitor" Width="26" Height="26"
                                             Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="Admin Console" Foreground="White"
                               FontSize="18" FontWeight="Medium"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                
                
                
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding CurrentPageTitle}"
                           Foreground="#FF80CBC4" FontSize="13"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <!-- ROW 1 — Sidebar + Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#FF2C3E44">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" /> <RowDefinition Height="Auto" /> </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style x:Key="SideNavButton" TargetType="Button">
                            <Setter Property="Background"                 Value="Transparent" />
                            <Setter Property="BorderThickness"            Value="0" />
                            <Setter Property="Foreground"                 Value="#FFECEFF1" />
                            <Setter Property="FontSize"                   Value="13" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Padding"                    Value="16,10" />
                            <Setter Property="Margin"                     Value="6,2" />
                            <Setter Property="Cursor"                     Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="#33FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="#55FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>

                    <StackPanel Grid.Row="0" Margin="0,12,0,0">
                        <Button Style="{StaticResource SideNavButton}" Command="{Binding NavigateToCommand}" CommandParameter="0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccessPoint" Width="18" Height="18" Foreground="#FF80CBC4" VerticalAlignment="Center" />
                                <TextBlock Text="Ping Dashboard" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SideNavButton}" Command="{Binding NavigateToCommand}" CommandParameter="1">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClockAlertOutline"
                                                         Width="18" Height="18"
                                                         Foreground="#FF80CBC4"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="Uptime" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        
                        <Button Style="{StaticResource SideNavButton}" Command="{Binding NavigateToCommand}" CommandParameter="2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cpu64Bit" Width="18" Height="18" Foreground="#FF80CBC4" VerticalAlignment="Center" />
                                <TextBlock Text="Resources" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SideNavButton}" Command="{Binding NavigateToCommand}" CommandParameter="3">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="RemoteDesktop" Width="18" Height="18" Foreground="#FF80CBC4" VerticalAlignment="Center" />
                                <TextBlock Text="RDP Sessions" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SideNavButton}" Command="{Binding NavigateToCommand}" CommandParameter="4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Bell" Width="18" Height="18" Foreground="#FF80CBC4" VerticalAlignment="Center" />
                                <TextBlock Text="Zabbix Alerts" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SideNavButton}" Command="{Binding NavigateToCommand}" CommandParameter="5">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TextBox" Width="18" Height="18" Foreground="#FF80CBC4" VerticalAlignment="Center" />
                                <TextBlock Text="Logs" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button Grid.Row="1"
                            Style="{StaticResource SideNavButton}"
                            Command="{Binding OpenSettingsCommand}"
                            Margin="6,2,6,12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" Width="18" Height="18"
                                                     Foreground="#FF80CBC4" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Column divider -->
            <Border Grid.Column="1" Background="#FF37474F" />

            <!--
                ContentControl — єдина точка рендерингу активного View.

                Content="{Binding CurrentView}" → отримує ViewModel-об'єкт
                (PingDashboardViewModel, ResourceMonitorViewModel тощо).

                WPF знаходить відповідний DataTemplate у Window.Resources
                по типу об'єкта і рендерить відповідний UserControl.

                DataContext UserControl = сам ViewModel (WPF встановлює
                автоматично до рендерингу DataTemplate).

                Жодних DataTrigger, жодних inline instances, жодних
                Visibility переключень.
            -->
            <ContentControl
                Grid.Column="2"
                Content="{Binding CurrentView}"
                Margin="24"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />

        </Grid>

        <!-- ROW 2 — Status Bar -->
        <Border Grid.Row="2" Background="#FF1C282C" Padding="12,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="InformationOutline"
                                             Width="13" Height="13"
                                             Foreground="#FF80CBC4"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusBarText}"
                               Foreground="#FFECEFF1" FontSize="11"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="Admin Console v2.2"
                           Foreground="#44FFFFFF" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <!--
            Dialog Overlay — Grid поверх всього вмісту.
            Collapsed за замовчуванням.
            OverlayDialogService → MainWindow.ShowDialog() робить його Visible.
            Не впливає на DataContext жодного іншого елементу.
        -->
        <Grid x:Name="DialogOverlay"
              Grid.Row="0" Grid.RowSpan="3"
              Visibility="Collapsed"
              Panel.ZIndex="100">

            <Rectangle Fill="#BB000000" />

            <Border Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF2C3E44"
                    CornerRadius="8"
                    Padding="28,24">
                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                 Width="26" Height="26"
                                                 Foreground="#FFFFC107"
                                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="DialogTitle"
                                   Foreground="White" FontSize="16"
                                   FontWeight="SemiBold" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock x:Name="DialogBody"
                               Foreground="#FFCFD8DC" FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,28" LineHeight="20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                        <Button x:Name="DialogCancelButton"
                                Padding="16,8" Margin="0,0,12,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#22FFFFFF"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="#33FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="Cancel" Foreground="#FFECEFF1" FontSize="13" />
                        </Button>

                        <Button x:Name="DialogConfirmButton"
                                Padding="16,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#CCF44336"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="#EEF44336" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="DialogConfirmLabel"
                                       Text="Confirm" Foreground="White"
                                       FontSize="13" FontWeight="Medium" />
                        </Button>

                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <!--
            Settings Overlay — з'являється поверх всього при IsSettingsOpen = true.
            Той самий підхід що DialogOverlay — Grid шар з ZIndex.
            Закривається кнопкою або кліком на темний фон.
        -->
        <Grid x:Name="SettingsOverlay"
              Grid.Row="0" Grid.RowSpan="3"
              Panel.ZIndex="90">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Темний фон — клік закриває Settings -->
            <Rectangle Fill="#BB000000"
                       Cursor="Arrow">
                <Rectangle.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding CloseSettingsCommand}"/>
                </Rectangle.InputBindings>
            </Rectangle>

            <!-- Панель Settings -->
            <Border Width="420"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="#FF2C3E44"
                    BorderBrush="#FF37474F"
                    BorderThickness="1,0,0,0"
                    Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок Settings -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right"
                                Command="{Binding CloseSettingsCommand}"
                                Cursor="Hand" Padding="6">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <materialDesign:PackIcon Kind="Close"
                                                                 Width="18" Height="18"
                                                                 Foreground="#88FFFFFF"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Cog" Width="20" Height="20"
                                                     Foreground="#FF80CBC4"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" Foreground="White"
                                       FontSize="16" FontWeight="Medium"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Контент Settings — скролиться якщо не влізає -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- ══ RDP Credentials ══════════════════════════════════════════ -->
                            <TextBlock Text="RDP / quser" Foreground="#FF80CBC4"
                                       FontSize="11" FontWeight="SemiBold"
                                       Margin="0,0,0,8" />

                            <Border Background="#1AFFFFFF" CornerRadius="6"
                                    Padding="14,10" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Foreground="#FFECEFF1" FontSize="13"
                                                       Visibility="{Binding Settings.HasRdpCredentials,
                                                           Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Run Text="Логін: " Foreground="#FF80CBC4"/>
                                                <Run Text="{Binding Settings.RdpUsername, Mode=OneWay}"
                                                     FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <TextBlock Text="Не налаштовано" Foreground="#66FFFFFF"
                                                       FontSize="13" FontStyle="Italic">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Settings.HasRdpCredentials}"
                                                                         Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Command="{Binding Settings.EnterRdpEditModeCommand}"
                                                Margin="8,0,4,0" Padding="10,4" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Settings.IsRdpEditMode}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="#2280CBC4"
                                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="Змінити" Foreground="#FF80CBC4" FontSize="12"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#4480CBC4"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button Grid.Column="2"
                                                Command="{Binding Settings.ClearRdpCredentialsCommand}"
                                                Padding="10,4" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Settings.HasRdpCredentials}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="#22F44336"
                                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="Очистити" Foreground="#FFEF5350" FontSize="12"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#44F44336"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Settings.IsRdpEditMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBox Text="{Binding Settings.RdpNewUsername,
                                                     UpdateSourceTrigger=PropertyChanged}"
                                                 Foreground="White" Background="#22FFFFFF"
                                                 BorderBrush="#44FFFFFF" BorderThickness="1"
                                                 Padding="8,6" FontSize="12" Margin="0,0,0,6"
                                                 materialDesign:HintAssist.Hint="DOMAIN\username"
                                                 materialDesign:HintAssist.Foreground="#66FFFFFF"/>

                                        <PasswordBox x:Name="RdpPasswordBox"
                                                     PasswordChanged="RdpPasswordBox_PasswordChanged"
                                                     Foreground="White" Background="#22FFFFFF"
                                                     BorderBrush="#44FFFFFF" BorderThickness="1"
                                                     Padding="8,6" FontSize="12" Margin="0,0,0,10"
                                                     materialDesign:HintAssist.Hint="Пароль"
                                                     materialDesign:HintAssist.Foreground="#66FFFFFF"/>

                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding Settings.SaveRdpCredentialsCommand}"
                                                    Margin="0,0,8,0" Padding="12,6" Cursor="Hand"
                                                    IsEnabled="{Binding Settings.IsValidatingRdp,
                                                        Converter={StaticResource InverseBoolConverter}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="#2280CBC4"
                                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="Loading"
                                                                    Width="14" Height="14"
                                                                    Foreground="#FF80CBC4"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,6,0">
                                                                    <materialDesign:PackIcon.Style>
                                                                        <Style TargetType="materialDesign:PackIcon">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Settings.IsValidatingRdp}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </materialDesign:PackIcon.Style>
                                                                </materialDesign:PackIcon>
                                                                <TextBlock Foreground="#FF80CBC4"
                                                                           FontSize="12" FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="Зберегти"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Settings.IsValidatingRdp}" Value="True">
                                                                                    <Setter Property="Text" Value="Перевіряємо…"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#4480CBC4"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Command="{Binding Settings.CancelRdpEditCommand}"
                                                    Padding="12,6" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="#1AFFFFFF"
                                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <TextBlock Text="Скасувати" Foreground="#88FFFFFF" FontSize="12"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>

                                        <!-- Результат валідації RDP — аналогічно до ZabbixTestResult -->
                                        <TextBlock Text="{Binding Settings.RdpValidationResult, Mode=OneWay}"
                                                   FontSize="12" Margin="0,8,0,0"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FFEF5350"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Settings.RdpValidationSuccess}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF4CAF50"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Settings.RdpValidationResult}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
