                                                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                               Foreground="#FFECEFF1" FontSize="12">
                                                        <Run Text="@"/><Run Text="{Binding Username, Mode=OneWay}"/>
                                                        <Run Text=" (" Foreground="#66FFFFFF"/><Run Text="{Binding ChatId, Mode=OneWay}" Foreground="#66FFFFFF"/><Run Text=")" Foreground="#66FFFFFF"/>
                                                    </TextBlock>
                                                    <Button Grid.Column="1" Margin="6,0,0,0" Padding="8,3" Cursor="Hand"
                                                            Command="{Binding DataContext.Settings.DenyTelegramRequestCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Id}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="#22F44336" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                    <TextBlock Text="❌ Відхилити" Foreground="#FFEF5350" FontSize="11"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Дозволені користувачі -->
                            <Border Background="#1AFFFFFF" CornerRadius="6" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="Дозволені користувачі" Foreground="#FF80CBC4"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Немає" Foreground="#66FFFFFF" FontSize="12" FontStyle="Italic">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Settings.TelegramAllowedUsers.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Settings.TelegramAllowedUsers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                               Foreground="#FFECEFF1" FontSize="12">
                                                        <Run Text="@"/><Run Text="{Binding Username, Mode=OneWay}"/>
                                                        <Run Text=" (" Foreground="#66FFFFFF"/><Run Text="{Binding ChatId, Mode=OneWay}" Foreground="#66FFFFFF"/><Run Text=")" Foreground="#66FFFFFF"/>
                                                    </TextBlock>
                                                    <Button Grid.Column="1" Padding="8,3" Cursor="Hand"
                                                            Command="{Binding DataContext.Settings.RevokeTelegramUserCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding ChatId}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="#22F44336" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                    <TextBlock Text="🚫 Відкликати" Foreground="#FFEF5350" FontSize="11"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Роздільник -->
                            <Border Height="1" Background="#1AFFFFFF" Margin="0,12,0,12"/>
                            <!-- ══ Застарілий заголовок, див. нижче — залишено лише як коментар ══════════════════════════════════════ -->
                            <!-- ══ Моніторинг сервісів ══ -->
                            <TextBlock Text="Моніторинг сервісів" Foreground="#FF80CBC4"
                                       FontSize="11" FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <Border Background="#1AFFFFFF" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton IsChecked="{Binding Settings.RdpMonitoringEnabled}"
                                                  Margin="0,0,10,0"
                                                  Style="{DynamicResource MaterialDesignSwitchToggleButton}"/>
                                    <StackPanel>
                                        <TextBlock Text="RDP моніторинг (quser)"
                                                   Foreground="#FFECEFF1" FontSize="13"/>
                                        <TextBlock Text="Вимкнено — сесії не опитуються, credentials не запитуються"
                                                   Foreground="#66FFFFFF" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#1AFFFFFF" CornerRadius="6" Padding="14,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton IsChecked="{Binding Settings.ZabbixMonitoringEnabled}"
                                                  Margin="0,0,10,0"
                                                  Style="{DynamicResource MaterialDesignSwitchToggleButton}"/>
                                    <StackPanel>
                                        <TextBlock Text="Zabbix моніторинг"
                                                   Foreground="#FFECEFF1" FontSize="13"/>
                                        <TextBlock Text="Вимкнено — API не опитується, токен не запитується"
                                                   Foreground="#66FFFFFF" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Роздільник -->
                            <Border Height="1" Background="#1AFFFFFF" Margin="0,12,0,12"/>

                            <TextBlock Text="Загальні" Foreground="#FF80CBC4"
                                       FontSize="11" FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <Border Background="#1AFFFFFF" CornerRadius="6" Padding="14,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton IsChecked="{Binding Settings.CloseToTray}"
                                                  Margin="0,0,10,0"
                                                  Style="{DynamicResource MaterialDesignSwitchToggleButton}"/>
                                    <StackPanel>
                                        <TextBlock Text="Згортати у трей при закритті"
                                                   Foreground="#FFECEFF1" FontSize="13"/>
                                        <TextBlock Text="Програма залишається активною у системному треї"
                                                   Foreground="#66FFFFFF" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>