<UserControl
    x:Class="AdminConsole.Views.RdpSessionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:vm="clr-namespace:AdminConsole.ViewModels"
    xmlns:converters="clr-namespace:AdminConsole.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:RdpSessionViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="700" d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════
             ROW 0 — Toolbar
        ═══════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#1AFFFFFF"
                CornerRadius="6"
                Margin="0,0,0,8"
                Padding="16,0">
            <DockPanel VerticalAlignment="Center">

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="RemoteDesktop"
                                             Width="22" Height="22"
                                             Foreground="#FF80CBC4"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="RDP Session Monitor"
                               Foreground="White" FontSize="16" FontWeight="Medium"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Active pill -->
                    <Border Background="#224CAF50" CornerRadius="12"
                            Padding="12,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#FF4CAF50"
                                     VerticalAlignment="Center" />
                            <TextBlock Foreground="#FF4CAF50" FontSize="12"
                                       FontWeight="Medium" Margin="6,0,0,0"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding ActiveCount, Mode=OneWay}" />
                                <Run Text=" Active" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Disconnected pill -->
                    <Border Background="#22FFC107" CornerRadius="12" Padding="12,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#FFFFC107"
                                     VerticalAlignment="Center" />
                            <TextBlock Foreground="#FFFFC107" FontSize="12"
                                       FontWeight="Medium" Margin="6,0,0,0"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding DisconnectedCount, Mode=OneWay}" />
                                <Run Text=" Disconnected" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════
             ROW 1 — Server status pills
        ═══════════════════════════════════════ -->
        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding ServerStatuses}"
                      Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ServerPollStatusViewModel}">
                    <Border CornerRadius="6" Padding="12,6" Margin="0,0,8,0"
                            Background="#1AFFFFFF">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <!-- xmlns:converters declared on root — no inline namespace needed -->
                                    <SolidColorBrush
                                        Color="{Binding StatusColor,
                                                Converter={x:Static converters:StringToColorConverter.Instance}}" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Foreground="White" FontWeight="Medium"
                                       FontSize="12" Margin="8,0,6,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding ServerName, Mode=OneWay}" />
                            <TextBlock Foreground="#66FFFFFF" FontSize="11"
                                       VerticalAlignment="Center"
                                       Text="{Binding PollStatus, Mode=OneWay}" />
                            <TextBlock Foreground="#44FFFFFF" FontSize="10"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       FontFamily="Consolas, Courier New"
                                       Text="{Binding LastPolled, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ═══════════════════════════════════════
             ROW 2 — Sessions DataGrid
        ═══════════════════════════════════════ -->
        <DataGrid
            Grid.Row="2"
            ItemsSource="{Binding Sessions}"
            SelectedItem="{Binding SelectedSession}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            IsReadOnly="True"
            SelectionMode="Single"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            RowHeight="44"
            BorderThickness="0"
            Background="Transparent"
            Foreground="White"
            RowBackground="#0AFFFFFF"
            AlternatingRowBackground="#14FFFFFF"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"      Value="#2A37474F" />
                    <Setter Property="Foreground"      Value="#FF80CBC4" />
                    <Setter Property="FontSize"        Value="11" />
                    <Setter Property="FontWeight"      Value="SemiBold" />
                    <Setter Property="Padding"         Value="12,8" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush"     Value="#33FFFFFF" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="#FFECEFF1" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3380CBC4" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background"      Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="12,0"
                                        Background="{TemplateBinding Background}"
                                        BorderThickness="0">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>

                <!-- State indicator -->
                <DataGridTemplateColumn Header="STATE" Width="130"
                                        SortMemberPath="State">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:RdpSessionRowViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <SolidColorBrush
                                            Color="{Binding StateDotColor,
                                                    Converter={x:Static converters:StringToColorConverter.Instance}}" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="{Binding StateLabel}"
                                           Margin="8,0,0,0"
                                           FontSize="12" FontWeight="Medium"
                                           VerticalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush
                                            Color="{Binding StateTextColor,
                                                    Converter={x:Static converters:StringToColorConverter.Instance}}" />
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Username -->
                <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FFECEFF1" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontWeight"        Value="Medium" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Session Name -->
                <DataGridTextColumn Header="SESSION" Binding="{Binding SessionName}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FF90A4AE" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"        Value="Consolas, Courier New" />
                            <Setter Property="FontSize"          Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Session ID -->
                <DataGridTextColumn Header="ID" Binding="{Binding SessionId}" Width="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FF90A4AE" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"        Value="Consolas, Courier New" />
                            <Setter Property="FontSize"          Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Server -->
                <DataGridTextColumn Header="SERVER" Binding="{Binding ServerName}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FFECEFF1" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Idle Time -->
                <DataGridTextColumn Header="IDLE" Binding="{Binding IdleTime}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FF90A4AE" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"        Value="Consolas, Courier New" />
                            <Setter Property="FontSize"          Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Logon Time -->
                <DataGridTextColumn Header="LOGON TIME" Binding="{Binding LogonTime}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FF90A4AE" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"        Value="Consolas, Courier New" />
                            <Setter Property="FontSize"          Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══════════════════════════════════════
             ROW 3 — Summary strip
        ═══════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="#1AFFFFFF"
                CornerRadius="4"
                Padding="12,0"
                Margin="0,6,0,0">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="#99FFFFFF"
                       FontSize="11"
                       VerticalAlignment="Center" />
        </Border>

    </Grid>
</UserControl>