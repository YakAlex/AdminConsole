<UserControl
    x:Class="AdminConsole.Views.UptimeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:vm="clr-namespace:AdminConsole.ViewModels"
    xmlns:models="clr-namespace:AdminConsole.Core.Models"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:UptimeViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="700" d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar -->
            <RowDefinition Height="56" />
            <!-- Summary pills -->
            <RowDefinition Height="Auto" />
            <!-- Filter bar -->
            <RowDefinition Height="Auto" />
            <!-- DataGrid -->
            <RowDefinition Height="*" />
            <!-- Detail strip -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════
             ROW 0 — Toolbar
        ═══════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1AFFFFFF"
                CornerRadius="6" Margin="0,0,0,8" Padding="16,0">
            <DockPanel VerticalAlignment="Center">

                <!-- Заголовок -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ClockAlertOutline"
                                             Width="22" Height="22"
                                             Foreground="#FF80CBC4"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="Uptime &amp; Incidents"
                               Foreground="White" FontSize="16" FontWeight="Medium"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Права панель кнопок — DockPanel.Dock="Right", порядок важливий -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Кнопка скинути фільтри — видима тільки якщо є активні фільтри -->
                    <Button Command="{Binding ClearFiltersCommand}"
                            Padding="10,6" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveFilters}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#22F44336"
                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FilterRemove"
                                                                 Width="14" Height="14"
                                                                 Foreground="#FFF44336"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="Скинути фільтри"
                                                   Foreground="#FFF44336" FontSize="12"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#44F44336" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Кнопка Clear History — видима тільки якщо є завершені записи -->
                    <Button Command="{Binding ClearAllResolvedCommand}"
                            Padding="10,6" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResolvedRecords}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#22FF9800"
                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteSweep"
                                                                 Width="14" Height="14"
                                                                 Foreground="#FFFFA726"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="Clear History"
                                                   Foreground="#FFFFA726" FontSize="12"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#44FF9800" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════
             ROW 1 — Summary pills
        ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">

            <!-- Активні інциденти -->
            <Border Background="#22F44336" CornerRadius="8"
                    Padding="16,8" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircle"
                                             Width="16" Height="16"
                                             Foreground="#FFEF5350"
                                             VerticalAlignment="Center" />
                    <TextBlock Foreground="#FFEF5350" FontSize="13"
                               FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center">
                        <Run Text="{Binding ActiveIncidents, Mode=OneWay}" />
                        <Run Text=" ACTIVE" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Сьогодні -->
            <Border Background="#22FF9800" CornerRadius="8"
                    Padding="16,8" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CalendarToday"
                                             Width="16" Height="16"
                                             Foreground="#FFFFA726"
                                             VerticalAlignment="Center" />
                    <TextBlock Foreground="#FFFFA726" FontSize="13"
                               FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center">
                        <Run Text="{Binding TodayIncidents, Mode=OneWay}" />
                        <Run Text=" TODAY" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Всього -->
            <Border Background="#1AFFFFFF" CornerRadius="8"
                    Padding="16,8" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FormatListBulleted"
                                             Width="16" Height="16"
                                             Foreground="#FF80CBC4"
                                             VerticalAlignment="Center" />
                    <TextBlock Foreground="#FF80CBC4" FontSize="13"
                               FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center">
                        <Run Text="{Binding TotalIncidents, Mode=OneWay}" />
                        <Run Text=" TOTAL" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Найдовший простій -->
            <Border Background="#1AFFFFFF" CornerRadius="8" Padding="16,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="TimerSand"
                                             Width="16" Height="16"
                                             Foreground="#FF80CBC4"
                                             VerticalAlignment="Center" />
                    <TextBlock Foreground="#FF90A4AE" FontSize="13"
                               Margin="8,0,0,0" VerticalAlignment="Center">
                        <Run Text="Max Downtime: " />
                        <Run Text="{Binding LongestDowntime, Mode=OneWay}"
                             Foreground="#FFECEFF1" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- ═══════════════════════════════════════
             ROW 2 — Filter bar
        ═══════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#1AFFFFFF"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal">

                <!-- Пошук по назві сервера -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14"
                                             Foreground="#FF80CBC4"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0" />
                    <TextBox Text="{Binding FilterServer, UpdateSourceTrigger=PropertyChanged}"
                             Width="160" Foreground="White"
                             Background="Transparent" BorderThickness="0,0,0,1"
                             BorderBrush="#44FFFFFF" FontSize="12"
                             materialDesign:HintAssist.Hint="Machine…"
                             materialDesign:HintAssist.Foreground="#66FFFFFF" />
                </StackPanel>

                <!-- Фільтр по групі -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Group:" Foreground="#FF80CBC4"
                               FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding AvailableGroups}"
                              SelectedItem="{Binding FilterGroup}"
                              Width="150" Foreground="White"
                              Background="Transparent"
                              BorderBrush="#44FFFFFF" FontSize="12" />
                </StackPanel>

                <!-- Фільтр по статусу -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Status:" Foreground="#FF80CBC4"
                               FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding FilterStatus}"
                              Width="120" Foreground="White"
                              Background="Transparent"
                              BorderBrush="#44FFFFFF" FontSize="12" />
                </StackPanel>

                <!-- Дата від -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="From:" Foreground="#FF80CBC4"
                               FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding FilterDateFrom}"
                                Width="130" Foreground="White"
                                Background="Transparent"
                                BorderBrush="#44FFFFFF" FontSize="12" />
                </StackPanel>

                <!-- Дата до -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="To:" Foreground="#FF80CBC4"
                               FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding FilterDateTo}"
                                Width="130" Foreground="White"
                                Background="Transparent"
                                BorderBrush="#44FFFFFF" FontSize="12" />
                </StackPanel>

            </WrapPanel>
        </Border>

        <!-- ═══════════════════════════════════════
             ROW 3 — DataGrid
        ═══════════════════════════════════════ -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding RecordsView.View}"
                  SelectedItem="{Binding SelectedRecord}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="44"
                  BorderThickness="0"
                  Background="Transparent"
                  Foreground="White"
                  RowBackground="#0AFFFFFF"
                  AlternatingRowBackground="#14FFFFFF"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"      Value="#2A37474F" />
                    <Setter Property="Foreground"      Value="#FF80CBC4" />
                    <Setter Property="FontSize"        Value="11" />
                    <Setter Property="FontWeight"      Value="SemiBold" />
                    <Setter Property="Padding"         Value="12,8" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush"     Value="#33FFFFFF" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3380CBC4" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background"      Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="12,0"
                                        Background="{TemplateBinding Background}"
                                        BorderThickness="0">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>

                <!-- Статус badge -->
                <DataGridTemplateColumn Header="STATUS" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type models:DowntimeRecord}">
                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#2200C853" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsResolved}" Value="False">
                                                <Setter Property="Background" Value="#22F44336" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text"       Value="✅ RESOLVED" />
                                            <Setter Property="Foreground" Value="#FF4CAF50" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsResolved}" Value="False">
                                                    <Setter Property="Text"       Value="🔴 ACTIVE" />
                                                    <Setter Property="Foreground" Value="#FFEF5350" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Сервер -->
                <DataGridTextColumn Header="SERVER"
                                    Binding="{Binding ServerName}"
                                    Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"    Value="#FFECEFF1" />
                            <Setter Property="FontWeight"    Value="Medium" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Група -->
                <DataGridTextColumn Header="GROUP"
                                    Binding="{Binding ServerGroup}"
                                    Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FF80CBC4" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontSize"          Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Впав о -->
                <DataGridTextColumn Header="DOWN AT"
                                    Binding="{Binding FellAt,
                                        StringFormat='{}{0:dd.MM HH:mm:ss}'}"
                                    Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"    Value="#FFEF9A9A" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"    Value="Consolas, Courier New" />
                            <Setter Property="FontSize"      Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Відновлено о -->
                <DataGridTextColumn Header="RECOVERED AT"
                                    Binding="{Binding RecoveredAt,
                                        StringFormat='{}{0:dd.MM HH:mm:ss}'}"
                                    Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"    Value="#FFA5D6A7" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"    Value="Consolas, Courier New" />
                            <Setter Property="FontSize"      Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Тривалість -->
                <DataGridTextColumn Header="DURATION"
                                    Binding="{Binding DurationDisplay}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"    Value="#FFECEFF1" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"    Value="Consolas, Courier New" />
                            <Setter Property="FontWeight"    Value="SemiBold" />
                            <Setter Property="FontSize"      Value="13" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Видалення запису -->
                <DataGridTemplateColumn Header="" Width="48" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type models:DowntimeRecord}">
                            <Button
                                Command="{Binding DataContext.DeleteRecordCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding}"
                                Width="28" Height="28"
                                Cursor="Hand"
                                ToolTipService.ShowOnDisabled="True"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background"   Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Opacity"      Value="0" />
                                        <Setter Property="ToolTip"      Value="Видалити інцидент" />
                                        <!-- Кнопка з'являється тільки при hover на рядку —
                                             не захаращує таблицю коли не потрібна -->
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsMouseOver,
                                                    RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                            <!-- Для активних записів — заблокована з поясненням -->
                                            <DataTrigger Binding="{Binding IsResolved}" Value="False">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="ToolTip"
                                                        Value="Неможливо видалити: сервер ще offline" />
                                                <Setter Property="Opacity" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Width="28" Height="28">
                                            <materialDesign:PackIcon
                                                Kind="DeleteOutline"
                                                Width="16" Height="16"
                                                Foreground="#88FFFFFF"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd"
                                                        Property="Background"
                                                        Value="#33F44336" />
                                                <Setter Property="Foreground"
                                                        Value="#FFEF5350" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══════════════════════════════════════
             ROW 4 — Detail strip
        ═══════════════════════════════════════ -->
        <Border Grid.Row="4" Background="#1AFFFFFF"
                CornerRadius="4" Padding="12,8"
                Margin="0,6,0,0" MinHeight="44">
            <Grid>
                <TextBlock Text="Оберіть рядок для деталей інциденту."
                           Foreground="#44FFFFFF" FontSize="11" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRecord}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRecord}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Foreground="#FF80CBC4" FontSize="12"
                               FontFamily="Consolas, Courier New">
                        <Run Text="{Binding SelectedRecord.ServerName, Mode=OneWay}"
                             FontWeight="SemiBold" Foreground="White" />
                        <Run Text="  |  " Foreground="#33FFFFFF" />
                        <Run Text="{Binding SelectedRecord.ServerIp, Mode=OneWay}" />
                        <Run Text="  |  Впав: " Foreground="#44FFFFFF" />
                        <Run Text="{Binding SelectedRecord.FellAt,
                                   StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}',
                                   Mode=OneWay}"
                             Foreground="#FFEF9A9A" />
                        <Run Text="  |  Простій: " Foreground="#44FFFFFF" />
                        <Run Text="{Binding SelectedRecord.DurationDisplay, Mode=OneWay}"
                             Foreground="#FFECEFF1" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>