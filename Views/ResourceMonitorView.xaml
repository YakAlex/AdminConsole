<UserControl
    x:Class="AdminConsole.Views.ResourceMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:converters="clr-namespace:AdminConsole.Converters"
    xmlns:vm="clr-namespace:AdminConsole.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:ResourceMonitorViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:SeverityToColorConverter  x:Key="SeverityToColor" />
        <converters:DoubleToProgressConverter x:Key="ToProgress" />
        <BooleanToVisibilityConverter         x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- Блокуємо весь UI якщо не Windows -->
    <Grid IsEnabled="{Binding IsWindowsSupported}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Header: ComboBox вибору сервера -->
            <RowDefinition Height="Auto" />  <!-- CPU + RAM cards -->
            <RowDefinition Height="Auto" />  <!-- Event log header -->
            <RowDefinition Height="*"    />  <!-- Event log DataGrid -->
            <RowDefinition Height="Auto" />  <!-- Detail strip -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════
             ROW 0 — Server selector header
        ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#1AFFFFFF"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*"    />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Іконка + підпис -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="ServerNetwork"
                                             Width="22" Height="22"
                                             Foreground="#FF80CBC4"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="Node Dashboard"
                               Foreground="White"
                               FontSize="15" FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- ComboBox вибору сервера -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableServers}"
                          SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          MaxWidth="340"
                          HorizontalAlignment="Left"
                          Foreground="White"
                          Background="#22FFFFFF"
                          BorderThickness="0"
                          Padding="12,6"
                          FontSize="13">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- Ping-статус dot (лише для remote) -->
                                <Ellipse Width="8" Height="8"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocal}" Value="False">
                                                    <Setter Property="Fill" Value="#FF80CBC4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="#FFECEFF1"
                                           VerticalAlignment="Center" />
                                <!-- IP для remote серверів -->
                                <TextBlock Margin="8,0,0,0"
                                           Foreground="#66FFFFFF"
                                           FontSize="11"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocal}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Text"
                                                            Value="{Binding IP}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Ping status badge для вибраного remote сервера -->
                <TextBlock Grid.Column="2"
                           Text="{Binding ServerStatusBadge}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FF80CBC4" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ServerStatusBadge}"
                                             Value="● Offline">
                                    <Setter Property="Foreground" Value="#FFF44336" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ServerStatusBadge}"
                                             Value="● Online">
                                    <Setter Property="Foreground" Value="#FF4CAF50" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Банер "не Windows" -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Background="#CC1C282C"
                CornerRadius="8"
                Visibility="{Binding IsWindowsUnsupported,
                             Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Monitor"
                                         Width="48" Height="48"
                                         Foreground="#FF80CBC4"
                                         HorizontalAlignment="Center" />
                <TextBlock Text="Windows only"
                           Foreground="White" FontSize="16" FontWeight="Medium"
                           HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="Node Dashboard requires Windows (WMI / Event Log)."
                           Foreground="#66FFFFFF" FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             ROW 1 — CPU + RAM gauge cards
        ══════════════════════════════════════════════════ -->
        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,16">

            <!-- CPU Card -->
            <Border Background="#1AFFFFFF" CornerRadius="8"
                    Padding="20,16" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="Cpu64Bit"
                                                 Width="20" Height="20"
                                                 Foreground="#FF80CBC4"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="CPU Usage" Foreground="#FF80CBC4"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding CpuLabel}"
                               Foreground="{Binding CpuBarBrush}"
                               FontSize="36" FontWeight="Light"
                               Margin="0,0,0,12" />

                    <ProgressBar Grid.Row="2"
                                 Value="{Binding CpuPercent,
                                         Converter={StaticResource ToProgress},
                                         Mode=OneWay}"
                                 Minimum="0" Maximum="100"
                                 Height="8"
                                 Foreground="{Binding CpuBarBrush}"
                                 Background="#22FFFFFF"
                                 Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3"
                               Text="{Binding LastUpdated,
                                      StringFormat='Last updated: {0}'}"
                               Foreground="#66FFFFFF" FontSize="11" />
                </Grid>
            </Border>

            <!-- RAM Card -->
            <Border Background="#1AFFFFFF" CornerRadius="8"
                    Padding="20,16" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="Memory"
                                                 Width="20" Height="20"
                                                 Foreground="#FF80CBC4"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="RAM Usage" Foreground="#FF80CBC4"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding RamLabel}"
                               Foreground="{Binding RamBarBrush}"
                               FontSize="36" FontWeight="Light"
                               Margin="0,0,0,12" />

                    <ProgressBar Grid.Row="2"
                                 Value="{Binding RamPercent,
                                         Converter={StaticResource ToProgress},
                                         Mode=OneWay}"
                                 Minimum="0" Maximum="100"
                                 Height="8"
                                 Foreground="{Binding RamBarBrush}"
                                 Background="#22FFFFFF"
                                 Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3"
                               Text="{Binding RamPercent,
                                      StringFormat='{}{0:F1} % used'}"
                               Foreground="#66FFFFFF" FontSize="11" />
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ══════════════════════════════════════════════════
             ROW 2 — Event Log section header
        ══════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <materialDesign:PackIcon Kind="AlertCircleOutline"
                                     Width="18" Height="18"
                                     Foreground="#FFFFC107"
                                     VerticalAlignment="Center" />
            <TextBlock Text="Recent System Errors"
                       Foreground="White" FontSize="14" FontWeight="Medium"
                       Margin="8,0,16,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding EventLogStatus}"
                       Foreground="#66FFFFFF" FontSize="11"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- ══════════════════════════════════════════════════
             ROW 3 — Event Log DataGrid
        ══════════════════════════════════════════════════ -->
        <DataGrid
            Grid.Row="3"
            ItemsSource="{Binding EventEntries}"
            SelectedItem="{Binding SelectedEntry}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            IsReadOnly="True"
            SelectionMode="Single"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            RowHeight="40"
            BorderThickness="0"
            Background="Transparent"
            Foreground="White"
            RowBackground="#0AFFFFFF"
            AlternatingRowBackground="#14FFFFFF"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"      Value="#2A37474F" />
                    <Setter Property="Foreground"      Value="#FF80CBC4" />
                    <Setter Property="FontSize"        Value="11" />
                    <Setter Property="FontWeight"      Value="SemiBold" />
                    <Setter Property="Padding"         Value="12,8" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush"     Value="#33FFFFFF" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="#FFECEFF1" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3380CBC4" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background"      Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="12,0"
                                        Background="{TemplateBinding Background}"
                                        BorderThickness="0">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="LEVEL" Width="100" SortMemberPath="Severity">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:EventLogEntryViewModel}">
                            <Border CornerRadius="4" Padding="6,2"
                                    HorizontalAlignment="Left"
                                    Background="{Binding Severity,
                                                 Converter={StaticResource SeverityToColor}}">
                                <TextBlock Text="{Binding SeverityLabel}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="White" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FF90A4AE" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"        Value="Consolas, Courier New" />
                            <Setter Property="FontSize"          Value="11" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FFECEFF1" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontWeight"        Value="Medium" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="EVENT ID" Binding="{Binding EventId}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FF90A4AE" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"        Value="Consolas, Courier New" />
                            <Setter Property="FontSize"          Value="11" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="MESSAGE" Binding="{Binding ShortMessage}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FFCFD8DC" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ══════════════════════════════════════════════════
             ROW 4 — Selected entry detail strip
        ══════════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="#1AFFFFFF"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,6,0,0"
                MinHeight="48">
            <Grid>
                <TextBlock Text="Select a row to see the full message."
                           Foreground="#44FFFFFF" FontSize="11"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding SelectedEntryFullMessage}"
                           Foreground="#FFECEFF1" FontSize="12"
                           TextWrapping="Wrap" MaxHeight="72"
                           VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

    </Grid>
</UserControl>