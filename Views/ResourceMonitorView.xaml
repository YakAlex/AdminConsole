<UserControl
    x:Class="AdminConsole.Views.ResourceMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:converters="clr-namespace:AdminConsole.Converters"
    xmlns:models="clr-namespace:AdminConsole.Core.Models"
    xmlns:vm="clr-namespace:AdminConsole.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:ResourceMonitorViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:SeverityToColorConverter    x:Key="SeverityToColor" />
        <converters:DoubleToProgressConverter   x:Key="ToProgress" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Gauge cards -->
            <RowDefinition Height="Auto" />
            <!-- Divider label -->
            <RowDefinition Height="Auto" />
            <!-- Event log grid -->
            <RowDefinition Height="*" />
            <!-- Detail strip -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════
             ROW 0 — CPU + RAM gauge cards
        ═══════════════════════════════════════════════ -->
        <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,16">

            <!-- CPU Card -->
            <Border
                Background="#1AFFFFFF"
                CornerRadius="8"
                Padding="20,16"
                Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon
                            Kind="Cpu64Bit"
                            Width="20" Height="20"
                            Foreground="#FF80CBC4"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="CPU Usage"
                            Foreground="#FF80CBC4"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Big percentage label -->
                    <TextBlock
                        Grid.Row="1"
                        Text="{Binding CpuLabel}"
                        Foreground="White"
                        FontSize="36"
                        FontWeight="Light"
                        Margin="0,0,0,12" />

                    <!-- Progress bar -->
                    <ProgressBar
                        Grid.Row="2"
                        Value="{Binding CpuPercent,
                                        Converter={StaticResource ToProgress},
                                        Mode=OneWay}"
                        Minimum="0"
                        Maximum="100"
                        Height="8"
                        Background="#22FFFFFF"
                        Margin="0,0,0,8">
                        <ProgressBar.Foreground>
                            <SolidColorBrush
                                Color="{Binding CpuBarColor,
                                                Converter={x:Static converters:StringToColorConverter.Instance}}" />
                        </ProgressBar.Foreground>
                    </ProgressBar>

                    <TextBlock
                        Grid.Row="3"
                        Text="{Binding LastUpdated, StringFormat='Last updated: {0}'}"
                        Foreground="#66FFFFFF"
                        FontSize="11" />
                </Grid>
            </Border>

            <!-- RAM Card -->
            <Border
                Background="#1AFFFFFF"
                CornerRadius="8"
                Padding="20,16"
                Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon
                            Kind="Memory"
                            Width="20" Height="20"
                            Foreground="#FF80CBC4"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="RAM Usage"
                            Foreground="#FF80CBC4"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- GB label -->
                    <TextBlock
                        Grid.Row="1"
                        Text="{Binding RamLabel}"
                        Foreground="White"
                        FontSize="36"
                        FontWeight="Light"
                        Margin="0,0,0,12" />

                    <!-- Progress bar -->
                    <ProgressBar
                        Grid.Row="2"
                        Value="{Binding RamPercent,
                                        Converter={StaticResource ToProgress},
                                        Mode=OneWay}"
                        Minimum="0"
                        Maximum="100"
                        Height="8"
                        Background="#22FFFFFF"
                        Margin="0,0,0,8">
                        <ProgressBar.Foreground>
                            <SolidColorBrush
                                Color="{Binding RamBarColor,
                                                Converter={x:Static converters:StringToColorConverter.Instance}}" />
                        </ProgressBar.Foreground>
                    </ProgressBar>

                    <TextBlock
                        Grid.Row="3"
                        Text="{Binding RamPercent, StringFormat='{}{0:F1} % used'}"
                        Foreground="#66FFFFFF"
                        FontSize="11" />
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ═══════════════════════════════════════════════
             ROW 1 — Event Log section header
        ═══════════════════════════════════════════════ -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,0,0,8">
            <materialDesign:PackIcon
                Kind="AlertCircleOutline"
                Width="18" Height="18"
                Foreground="#FFFFC107"
                VerticalAlignment="Center" />
            <TextBlock
                Text="Recent System Errors"
                Foreground="White"
                FontSize="14"
                FontWeight="Medium"
                Margin="8,0,16,0"
                VerticalAlignment="Center" />
            <TextBlock
                Text="{Binding EventLogStatus}"
                Foreground="#66FFFFFF"
                FontSize="11"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- ═══════════════════════════════════════════════
             ROW 2 — Event Log DataGrid
        ═══════════════════════════════════════════════ -->
        <DataGrid
            Grid.Row="2"
            ItemsSource="{Binding EventEntries}"
            SelectedItem="{Binding SelectedEntry}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            IsReadOnly="True"
            SelectionMode="Single"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            RowHeight="40"
            BorderThickness="0"
            Background="Transparent"
            Foreground="White"
            RowBackground="#0AFFFFFF"
            AlternatingRowBackground="#14FFFFFF"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"      Value="#2A37474F" />
                    <Setter Property="Foreground"      Value="#FF80CBC4" />
                    <Setter Property="FontSize"        Value="11" />
                    <Setter Property="FontWeight"      Value="SemiBold" />
                    <Setter Property="Padding"         Value="12,8" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush"     Value="#33FFFFFF" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="#FFECEFF1" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3380CBC4" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background"      Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border
                                    Padding="12,0"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>

                <!-- Severity badge -->
                <DataGridTemplateColumn Header="LEVEL" Width="100" SortMemberPath="Severity">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:EventLogEntryViewModel}">
                            <Border
                                CornerRadius="4"
                                Padding="6,2"
                                HorizontalAlignment="Left"
                                Background="{Binding Severity,
                                             Converter={StaticResource SeverityToColor},
                                             ConverterParameter=bg}">
                                <TextBlock
                                    Text="{Binding SeverityLabel}"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="White" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Time -->
                <DataGridTextColumn
                    Header="TIME"
                    Binding="{Binding Time}"
                    Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FF90A4AE" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"        Value="Consolas, Courier New" />
                            <Setter Property="FontSize"          Value="11" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Source -->
                <DataGridTextColumn
                    Header="SOURCE"
                    Binding="{Binding Source}"
                    Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FFECEFF1" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontWeight"        Value="Medium" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Event ID -->
                <DataGridTextColumn
                    Header="EVENT ID"
                    Binding="{Binding EventId}"
                    Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FF90A4AE" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"        Value="Consolas, Courier New" />
                            <Setter Property="FontSize"          Value="11" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Message (truncated) -->
                <DataGridTextColumn
                    Header="MESSAGE"
                    Binding="{Binding ShortMessage}"
                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FFCFD8DC" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══════════════════════════════════════════════
             ROW 3 — Selected entry detail strip
        ═══════════════════════════════════════════════ -->
        <Border
            Grid.Row="3"
            Background="#1AFFFFFF"
            CornerRadius="4"
            Padding="12,8"
            Margin="0,6,0,0"
            MinHeight="48">
            <Grid>
                <TextBlock
                    Text="Select a row to see the full message."
                    Foreground="#44FFFFFF"
                    FontSize="11"
                    VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding SelectedEntry}"
                                    Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    Text="{Binding SelectedEntryFullMessage}"
                    Foreground="#FFECEFF1"
                    FontSize="11"
                    TextWrapping="Wrap"
                    MaxHeight="72"
                    VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding SelectedEntry}"
                                    Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

    </Grid>
</UserControl>