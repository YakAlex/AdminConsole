<Window
    x:Class="AdminConsole.Views.MaintenanceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Maintenance"
    Width="420" SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="#FF263238"
    TextElement.Foreground="White"
    TextElement.FontFamily="{materialDesign:MaterialDesignFont}"
    TextElement.FontSize="13"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="Grayscale"
    TextOptions.TextHintingMode="Fixed"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <Style x:Key="DurationButton" TargetType="Button">
            <Setter Property="Padding" Value="0,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#CC0097A7" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EE0097A7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IndefiniteButton" TargetType="Button">
            <Setter Property="Padding" Value="0,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF212121" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#CCFFA726" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEFFA726" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="28,24">
        <StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <materialDesign:PackIcon Kind="Wrench"
                                         Width="26" Height="26"
                                         Foreground="#FFFFC107"
                                         VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderText"
                           Text="Maintenance"
                           FontSize="16" FontWeight="SemiBold"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Оберіть тривалість планового обслуговування:"
                       Foreground="#FFCFD8DC" FontSize="14"
                       TextWrapping="Wrap" Margin="0,0,0,16" />

            <TextBlock Text="Коментар (необов'язково)" Foreground="#FF80CBC4"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <TextBox
                x:Name="CommentBox"
                FontSize="13"
                Background="#22FFFFFF"
                Foreground="White"
                CaretBrush="White"
                BorderThickness="1"
                BorderBrush="#FF546E7A"
                Padding="10,8"
                MaxLength="300"
                Margin="0,0,0,18" />

            <UniformGrid Columns="3" Rows="1" Margin="0,0,0,10">
                <Button Content="10 хв" Style="{StaticResource DurationButton}"
                        Margin="0,0,6,0" Click="Duration10_Click" />
                <Button Content="30 хв" Style="{StaticResource DurationButton}"
                        Margin="6,0,6,0" Click="Duration30_Click" />
                <Button Content="60 хв" Style="{StaticResource DurationButton}"
                        Margin="6,0,0,0" Click="Duration60_Click" />
            </UniformGrid>

            <Button Content="Без обмеження — до ручного вимкнення"
                    Style="{StaticResource IndefiniteButton}"
                    Click="Indefinite_Click" />

            <Button x:Name="CancelBtn"
                    Content="Скасувати"
                    Padding="16,8"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Cursor="Hand" Click="CancelBtn_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#fff"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#fff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </Border>
</Window>