<UserControl
    x:Class="AdminConsole.Views.PingDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:converters="clr-namespace:AdminConsole.Converters"
    xmlns:models="clr-namespace:AdminConsole.Core.Models"
    xmlns:vm="clr-namespace:AdminConsole.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:PingDashboardViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <converters:PingStatusToColorConverter x:Key="StatusToColor" />
        <converters:PingStatusToTextConverter  x:Key="StatusToText" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <!-- Reusable action icon-button style -->
        <Style x:Key="ActionIconButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="6" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Width"           Value="32" />
            <Setter Property="Height"          Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════
             ROW 0 — Toolbar
        ═══════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#1AFFFFFF"
                CornerRadius="6"
                Margin="0,0,0,8"
                Padding="16,0">
            <DockPanel VerticalAlignment="Center">

                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccessPoint"
                                             Width="22" Height="22"
                                             Foreground="#FF80CBC4"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="Ping Dashboard"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="Medium"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Online pill -->
                    <Border Background="#224CAF50" CornerRadius="12"
                            Padding="12,4" Margin="4,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#FF4CAF50"
                                     VerticalAlignment="Center" />
                            <TextBlock Foreground="#FF4CAF50" FontSize="12"
                                       FontWeight="Medium" Margin="8,0,0,0"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding OnlineCount, Mode=OneWay}" />
                                <Run Text=" Online" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Offline pill -->
                    <Border Background="#22F44336" CornerRadius="12" Padding="12,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#FFF44336"
                                     VerticalAlignment="Center" />
                            <TextBlock Foreground="#FFF44336" FontSize="12"
                                       FontWeight="Medium" Margin="6,0,0,0"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding OfflineCount, Mode=OneWay}" />
                                <Run Text=" Offline" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════
             ROW 1 — DataGrid
        ═══════════════════════════════════════ -->
        <DataGrid
            Grid.Row="1"
            ItemsSource="{Binding GroupedServers.View}"
            SelectedItem="{Binding SelectedServer}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            IsReadOnly="True"
            materialDesign:DataGridAssist.EnableEditBoxAssist="False"
            SelectionMode="Single"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            RowHeight="44"
            BorderThickness="0"
            Background="Transparent"
            Foreground="White"
            RowBackground="#0AFFFFFF"
            AlternatingRowBackground="#14FFFFFF"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"      Value="#2A37474F" />
                    <Setter Property="Foreground"      Value="#FF80CBC4" />
                    <Setter Property="FontSize"        Value="11" />
                    <Setter Property="FontWeight"      Value="SemiBold" />
                    <Setter Property="Padding"         Value="12,8" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush"     Value="#33FFFFFF" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="#FFECEFF1" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3380CBC4" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background"      Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="12,0"
                                        Background="{TemplateBinding Background}"
                                        BorderThickness="0">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="#1580CBC4"
                                    Padding="12,6"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="#2280CBC4">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ServerNetwork"
                                                             Width="14" Height="14"
                                                             Foreground="#FF80CBC4"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name, Mode=OneWay}"
                                               Foreground="#FF80CBC4"
                                               FontSize="11" FontWeight="SemiBold"
                                               Margin="8,0,8,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Foreground="#8080CBC4"
                                               FontSize="11"
                                               VerticalAlignment="Center">
                                        <Run Text="(" />
                                        <Run Text="{Binding ItemCount, Mode=OneWay}" />
                                        <Run Text=" servers)" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>

            <DataGrid.Columns>

                <!-- Status -->
                <DataGridTemplateColumn Header="STATUS" Width="85" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:PingResultViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10"
                                         Fill="{Binding Status, Converter={StaticResource StatusToColor}}"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}"
                                                             Value="{x:Static models:PingStatus.Checking}">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="PulseStoryboard">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    From="1" To="0.15"
                                                                    Duration="0:0:0.8"
                                                                    AutoReverse="True" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock
                                    Text="{Binding Status, Converter={StaticResource StatusToText}}"
                                    Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                    FontSize="12" FontWeight="Medium"
                                    Margin="8,0,0,0" VerticalAlignment="Center" />

                                <materialDesign:PackIcon
                                    Kind="Wrench"
                                    Width="13" Height="13"
                                    Foreground="#FFFFC107"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding MaintenanceTooltip}">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnderMaintenance}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Name -->
                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FFECEFF1" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontWeight"        Value="Medium" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- IP -->
                <DataGridTextColumn Header="IP ADDRESS" Binding="{Binding IP}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FFECEFF1" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"        Value="Consolas, Courier New" />
                            <Setter Property="FontSize"          Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Group -->
                <DataGridTextColumn Header="GROUP" Binding="{Binding Group}" Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FF90A4AE" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Latency -->
                <DataGridTemplateColumn Header="LATENCY" Width="75" SortMemberPath="LatencyMs">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:PingResultViewModel}">
                            <TextBlock Text="{Binding LatencyDisplay}"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas, Courier New"
                                       FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FF80CBC4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}"
                                                         Value="{x:Static models:PingStatus.Offline}">
                                                <Setter Property="Foreground" Value="#FFF44336" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Last Checked -->
                <DataGridTextColumn Header="LAST CHECKED" Binding="{Binding LastChecked}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FF90A4AE" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"        Value="Consolas, Courier New" />
                            <Setter Property="FontSize"          Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <!-- Status Since -->
                <DataGridTemplateColumn Header="SINCE" Width="155" SortMemberPath="StatusSince">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:PingResultViewModel}">
                            <TextBlock Text="{Binding StatusSince}"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas, Courier New"
                                       FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FF80CBC4" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}"
                                                         Value="{x:Static models:PingStatus.Offline}">
                                                <Setter Property="Foreground" Value="#FFF44336" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- ══ ACTIONS column (new in Phase 5) ══ -->
                <DataGridTemplateColumn Header="ACTIONS" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:PingResultViewModel}">
                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding IsActionBusy,
                                    Converter={StaticResource InverseBoolConverter}}">

                                <!-- Ping -t (завжди видима для всіх типів) -->
                                <Button
                                    Style="{StaticResource ActionIconButton}"
                                    Command="{Binding PingContinuousCommand}"
                                    ToolTip="Open continuous ping (ping -t)">
                                    <materialDesign:PackIcon
                                        Kind="AccessPointNetwork"
                                        Width="16" Height="16"
                                        Foreground="#FF80CBC4" />
                                </Button>

                                <!-- RDP (тільки Windows) -->
                                <Button
                                    Command="{Binding OpenRdpCommand}"
                                    ToolTip="Open Remote Desktop (mstsc)"
                                    Margin="2,0">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource ActionIconButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWindows}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon
                                        Kind="RemoteDesktop"
                                        Width="16" Height="16"
                                        Foreground="#FF80CBC4" />
                                </Button>

                                <!-- SSH / PuTTY (тільки Linux) -->
                                <Button
                                    Command="{Binding OpenSshCommand}"
                                    ToolTip="Open SSH session (PuTTY)"
                                    Margin="2,0">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource ActionIconButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLinux}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon
                                        Kind="Console"
                                        Width="16" Height="16"
                                        Foreground="#FF80CBC4" />
                                </Button>
                                
                                <Button
                                    Style="{StaticResource ActionIconButton}"
                                    Command="{Binding ToggleMaintenanceCommand}"
                                    ToolTip="{Binding MaintenanceTooltip}"
                                    Margin="2,0">
                                    <Button.Content>
                                        <materialDesign:PackIcon
                                            Kind="Wrench"
                                            Width="16" Height="16">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Foreground" Value="#FF80CBC4" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnderMaintenance}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFFFC107" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </Button.Content>
                                </Button>
                                
                                <!-- Restart (тільки Windows) -->
                                <Button
                                    Command="{Binding RemoteRestartCommand}"
                                    ToolTip="Remote Restart (requires admin)"
                                    Margin="0,0,2,0">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource ActionIconButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWindows}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon
                                        Kind="Restart"
                                        Width="16" Height="16"
                                        Foreground="#FFFFC107" />
                                </Button>

                                <!-- Shutdown (тільки Windows) -->
                                <Button
                                    Command="{Binding RemoteShutdownCommand}"
                                    ToolTip="Remote Shutdown (requires admin)">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource ActionIconButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWindows}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon
                                        Kind="Power"
                                        Width="16" Height="16"
                                        Foreground="#FFF44336" />
                                </Button>

                                <!-- Іконка мережевого пристрою -->
                                <materialDesign:PackIcon
                                    Kind="RouterWireless"
                                    Width="16" Height="16"
                                    Foreground="#FF546E7A"
                                    VerticalAlignment="Center"
                                    Margin="6,0,0,0"
                                    ToolTip="Network device — management via web interface">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDevice}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══════════════════════════════════════
             ROW 2 — Summary strip
        ═══════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#1AFFFFFF"
                CornerRadius="4"
                Padding="12,0"
                Margin="0,6,0,0">
            <TextBlock Text="{Binding SummaryText}"
                       Foreground="#99FFFFFF"
                       FontSize="11"
                       VerticalAlignment="Center" />
        </Border>

    </Grid>
</UserControl>