<UserControl
    x:Class="AdminConsole.Views.ZabbixView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:converters="clr-namespace:AdminConsole.Converters"
    xmlns:models="clr-namespace:AdminConsole.Core.Models"
    xmlns:vm="clr-namespace:AdminConsole.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:ZabbixViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:ZabbixSeverityToColorConverter x:Key="SeverityToColor" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar -->
            <RowDefinition Height="56" />
            <!-- Severity summary strip -->
            <RowDefinition Height="Auto" />
            <!-- DataGrid -->
            <RowDefinition Height="*" />
            <!-- Detail / status strip -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════
             ROW 0 — Toolbar
        ═══════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#1AFFFFFF"
                CornerRadius="6"
                Margin="0,0,0,8"
                Padding="16,0">
            <DockPanel VerticalAlignment="Center">

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Bell"
                                             Width="22" Height="22"
                                             Foreground="#FF80CBC4"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="Zabbix Active Alerts"
                               Foreground="White" FontSize="16" FontWeight="Medium"
                               Margin="10,0,10,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Connection status pill -->
                <Border DockPanel.Dock="Right"
                        CornerRadius="12" Padding="12,4">
                    <Border.Background>
                        <SolidColorBrush
                            Color="{Binding StatusColor,
                                    Converter={x:Static converters:StringToColorConverter.Instance}}" />
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush
                                    Color="{Binding StatusColor,
                                            Converter={x:Static converters:StringToColorConverter.Instance}}" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatus, Mode=OneWay}"
                                   FontSize="12" FontWeight="Medium"
                                   Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <SolidColorBrush
                                    Color="{Binding StatusColor,
                                            Converter={x:Static converters:StringToColorConverter.Instance}}" />
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════
             ROW 1 — Severity summary pills
        ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">

            <!-- Disaster pill -->
            <Border Background="#22E53935" CornerRadius="8"
                    Padding="16,8" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertOctagon"
                                             Width="16" Height="16"
                                             Foreground="#FFEF5350"
                                             VerticalAlignment="Center" />
                    <TextBlock Foreground="#FFEF5350" FontSize="13"
                               FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center">
                        <Run Text="{Binding DisasterCount, Mode=OneWay}" />
                        <Run Text=" DISASTER" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- High pill -->
            <Border Background="#22FF5722" CornerRadius="8" Padding="16,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircle"
                                             Width="16" Height="16"
                                             Foreground="#FFFF7043"
                                             VerticalAlignment="Center" />
                    <TextBlock Foreground="#FFFF7043" FontSize="13"
                               FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center">
                        <Run Text="{Binding HighCount, Mode=OneWay}" />
                        <Run Text=" HIGH" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Last fetched -->
            <TextBlock Foreground="#44FFFFFF" FontSize="11"
                       Margin="16,0,0,0" VerticalAlignment="Center"
                       FontFamily="Consolas, Courier New">
                <Run Text="Last fetch: " />
                <Run Text="{Binding LastFetched, Mode=OneWay}" />
            </TextBlock>

        </StackPanel>

        <!-- ═══════════════════════════════════════
             ROW 2 — Problems DataGrid
        ═══════════════════════════════════════ -->
        <DataGrid
            Grid.Row="2"
            ItemsSource="{Binding Problems}"
            SelectedItem="{Binding SelectedProblem}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            IsReadOnly="True"
            SelectionMode="Single"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            RowHeight="44"
            BorderThickness="0"
            Background="Transparent"
            Foreground="White"
            RowBackground="#0AFFFFFF"
            AlternatingRowBackground="#14FFFFFF"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"      Value="#2A37474F" />
                    <Setter Property="Foreground"      Value="#FF80CBC4" />
                    <Setter Property="FontSize"        Value="11" />
                    <Setter Property="FontWeight"      Value="SemiBold" />
                    <Setter Property="Padding"         Value="12,8" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush"     Value="#33FFFFFF" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <!-- Row foreground driven by pre-computed brush on the VM -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground"
                            Value="{Binding RowForeground}" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3380CBC4" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background"      Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="12,0"
                                        Background="{TemplateBinding Background}"
                                        BorderThickness="0">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>

                <!-- Severity badge -->
                <DataGridTemplateColumn Header="SEVERITY" Width="110"
                                        SortMemberPath="Severity">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:ZabbixProblemViewModel}">
                            <Border Background="{Binding SeverityBackground}"
                                    CornerRadius="4" Padding="6,2"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding SeverityLabel}"
                                           Foreground="{Binding SeverityForeground}"
                                           FontSize="10" FontWeight="Bold" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Host -->
                <DataGridTextColumn Header="HOST"
                                    Binding="{Binding HostName}"
                                    Width="170">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FFECEFF1" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontWeight"        Value="Medium" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Description -->
                <DataGridTextColumn Header="PROBLEM"
                                    Binding="{Binding Description}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
                            <Setter Property="FontSize"          Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Age -->
                <DataGridTextColumn Header="AGE"
                                    Binding="{Binding AgeDisplay}"
                                    Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FF90A4AE" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"        Value="Consolas, Courier New" />
                            <Setter Property="FontSize"          Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Start time -->
                <DataGridTextColumn Header="SINCE"
                                    Binding="{Binding StartTime}"
                                    Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FF90A4AE" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"        Value="Consolas, Courier New" />
                            <Setter Property="FontSize"          Value="11" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══════════════════════════════════════
             ROW 3 — Selected problem detail strip
        ═══════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="#1AFFFFFF"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,6,0,0"
                MinHeight="44">
            <Grid>

                <TextBlock Text="Select a row to see the full problem description."
                           Foreground="#44FFFFFF" FontSize="11"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedProblem}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedProblem}"
                                             Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Foreground="#FF80CBC4" FontSize="12"
                               FontFamily="Consolas, Courier New">
                        <Run Text="{Binding SelectedProblem.HostName, Mode=OneWay}"
                             FontWeight="SemiBold" />
                        <Run Text="  |  " Foreground="#33FFFFFF" />
                        <Run Text="Event ID: " Foreground="#44FFFFFF" />
                        <Run Text="{Binding SelectedProblem.EventId, Mode=OneWay}" />
                        <Run Text="  |  Since: " Foreground="#44FFFFFF" />
                        <Run Text="{Binding SelectedProblem.StartTime, Mode=OneWay}" />
                        <Run Text="  |  Age: " Foreground="#44FFFFFF" />
                        <Run Text="{Binding SelectedProblem.AgeDisplay, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock
                        Text="{Binding SelectedProblem.Description, Mode=OneWay}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        MaxHeight="60"
                        Margin="0,4,0,0">
                        <TextBlock.Foreground>
                            <SolidColorBrush
                                Color="{Binding SelectedProblem.RowForeground.Color,
                                        Mode=OneWay,
                                        FallbackValue=#FFECEFF1}" />
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</UserControl>