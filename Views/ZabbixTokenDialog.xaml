<Window
    x:Class="AdminConsole.Views.ZabbixTokenDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Zabbix — API токен"
    Width="460" SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="#FF263238"
    TextElement.Foreground="White"
    TextElement.FontFamily="{materialDesign:MaterialDesignFont}">

    <Border Padding="28,24">
        <StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <materialDesign:PackIcon Kind="ShieldKey"
                                         Width="26" Height="26"
                                         Foreground="#FF80CBC4"
                                         VerticalAlignment="Center" />
                <TextBlock Text="Zabbix API токен"
                           FontSize="16" FontWeight="SemiBold"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock
                Text="Введи API токен із Zabbix (User → API tokens).&#10;Токен буде збережено у Windows Credential Manager — в appsettings нічого зберігати не потрібно."
                Foreground="#FFCFD8DC" FontSize="12"
                TextWrapping="Wrap" Margin="0,0,0,20"
                LineHeight="18" />

            <TextBlock Text="API Token" Foreground="#FF80CBC4"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="0,0,0,6" />

            <PasswordBox
                x:Name="TokenBox"
                FontSize="13"
                Background="#22FFFFFF"
                Foreground="White"
                BorderThickness="1"
                BorderBrush="#FF546E7A"
                Padding="10,8"
                PasswordChar="●"
                KeyDown="TokenBox_KeyDown" />

            <TextBlock x:Name="ErrorText"
                       Foreground="#FFF44336" FontSize="11"
                       Margin="0,6,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">

                <Button x:Name="CancelBtn"
                        Content="Скасувати"
                        Padding="16,8" Margin="0,0,12,0"
                        Cursor="Hand" Click="CancelBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#22FFFFFF"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="OkBtn"
                        Content="Зберегти"
                        Padding="16,8"
                        Cursor="Hand" Click="OkBtn_Click"
                        IsDefault="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#CC0097A7"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#EE0097A7" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </StackPanel>
    </Border>
</Window>