<UserControl
    x:Class="AdminConsole.Views.BackupsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:vm="clr-namespace:AdminConsole.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:BackupsViewModel, IsDesignTimeCreatable=False}"
    d:DesignHeight="700" d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar -->
            <RowDefinition Height="56" />
            <!-- Summary strip -->
            <RowDefinition Height="Auto" />
            <!-- DataGrid -->
            <RowDefinition Height="*" />
            <!-- Detail / error strip -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════
             ROW 0 — Toolbar
        ═══════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#1AFFFFFF"
                CornerRadius="6"
                Margin="0,0,0,8"
                Padding="16,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="DatabaseCheckOutline"
                                             Width="22" Height="22"
                                             Foreground="#FF80CBC4"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="Backup Verification"
                               Foreground="White" FontSize="16" FontWeight="Medium"
                               Margin="10,0,10,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Right"
                           Foreground="#44FFFFFF" FontSize="12"
                           VerticalAlignment="Center"
                           FontFamily="Consolas, Courier New">
                    <Run Text="Last update: " />
                    <Run Text="{Binding LastUpdated, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════
             ROW 1 — Outcome summary pills
        ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">

            <!-- OK pill -->
            <Border Background="#224CAF50" CornerRadius="8" Padding="16,8" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckCircleOutline"
                                             Width="16" Height="16"
                                             Foreground="#FF66BB6A" VerticalAlignment="Center" />
                    <TextBlock Foreground="#FF66BB6A" FontSize="13" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center">
                        <Run Text="{Binding OkCount, Mode=OneWay}" />
                        <Run Text=" OK" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- SizeWarning pill -->
            <Border Background="#22FFD600" CornerRadius="8" Padding="16,8" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertOutline"
                                             Width="16" Height="16"
                                             Foreground="#FFFFD600" VerticalAlignment="Center" />
                    <TextBlock Foreground="#FFFFD600" FontSize="13" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center">
                        <Run Text="{Binding WarningCount, Mode=OneWay}" />
                        <Run Text=" SIZE WARNING" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Stale/Missing pill -->
            <Border Background="#22E53935" CornerRadius="8" Padding="16,8" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertOctagon"
                                             Width="16" Height="16"
                                             Foreground="#FFEF5350" VerticalAlignment="Center" />
                    <TextBlock Foreground="#FFEF5350" FontSize="13" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center">
                        <Run Text="{Binding BadCount, Mode=OneWay}" />
                        <Run Text=" STALE/MISSING" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Unknown pill -->
            <Border Background="#22607D8B" CornerRadius="8" Padding="16,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="HelpCircleOutline"
                                             Width="16" Height="16"
                                             Foreground="#FF90A4AE" VerticalAlignment="Center" />
                    <TextBlock Foreground="#FF90A4AE" FontSize="13" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center">
                        <Run Text="{Binding UnknownCount, Mode=OneWay}" />
                        <Run Text=" UNKNOWN" />
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- ═══════════════════════════════════════
             ROW 2 — Rows DataGrid
        ═══════════════════════════════════════ -->
        <DataGrid
            Grid.Row="2"
            ItemsSource="{Binding Rows}"
            SelectedItem="{Binding SelectedRow}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            IsReadOnly="True"
            SelectionMode="Single"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            RowHeight="44"
            BorderThickness="0"
            Background="Transparent"
            Foreground="White"
            RowBackground="#0AFFFFFF"
            AlternatingRowBackground="#14FFFFFF"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"      Value="#2A37474F" />
                    <Setter Property="Foreground"      Value="#FF80CBC4" />
                    <Setter Property="FontSize"        Value="12" />
                    <Setter Property="FontWeight"      Value="SemiBold" />
                    <Setter Property="Padding"         Value="12,8" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush"     Value="#33FFFFFF" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{Binding RowForeground}" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3380CBC4" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background"      Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="12,0"
                                        Background="{TemplateBinding Background}"
                                        BorderThickness="0">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>

                <!-- Status badge -->
                <DataGridTemplateColumn Header="STATUS" Width="130" SortMemberPath="Outcome">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:BackupRowViewModel}">
                            <Border Background="{Binding BadgeBackground}"
                                    CornerRadius="4" Padding="6,2"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding OutcomeLabel}"
                                           Foreground="{Binding BadgeForeground}"
                                           FontSize="10" FontWeight="Bold" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Name -->
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FFECEFF1" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontWeight"        Value="Medium" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <!-- Host -->
                <DataGridTextColumn Header="HOST" Binding="{Binding Host}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FFECEFF1" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontWeight"        Value="Medium" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Kind: Full / Diff -->
                <DataGridTextColumn Header="TYPE" Binding="{Binding KindLabel}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FF90A4AE" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontSize"          Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Size -->
                <DataGridTextColumn Header="SIZE" Binding="{Binding LastSizeDisplay}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FFECEFF1" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"        Value="Consolas, Courier New" />
                            <Setter Property="FontSize"          Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Samples -->
                <DataGridTextColumn Header="SAMPLES" Binding="{Binding SamplesDisplay}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FF90A4AE" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"        Value="Consolas, Courier New" />
                            <Setter Property="FontSize"          Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Last confirmed -->
                <DataGridTextColumn Header="LAST CONFIRMED" Binding="{Binding LastConfirmedDisplay}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"        Value="#FF90A4AE" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontFamily"        Value="Consolas, Courier New" />
                            <Setter Property="FontSize"          Value="12" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Error (порожньо, якщо немає) -->
                <DataGridTextColumn Header="ERROR" Binding="{Binding LastError}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"   Value="#FFEF5350" />
                            <Setter Property="FontSize"     Value="12" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ══ ROW 2 (оверлай) — заглушка, коли BackupChecks не сконфігуровано ══ -->
        <Border Grid.Row="2"
                Background="#0AFFFFFF"
                CornerRadius="6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="DatabaseOffOutline"
                                         Width="48" Height="48"
                                         Foreground="#44FFFFFF"
                                         HorizontalAlignment="Center" />
                <TextBlock Text="Немає сконфігурованих перевірок бекапів"
                           Foreground="#66FFFFFF" FontSize="15" FontWeight="Medium"
                           HorizontalAlignment="Center" Margin="0,16,0,4" />
                <TextBlock Text="Додайте секцію «BackupChecks» в appsettings.json."
                           Foreground="#44FFFFFF" FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════
             ROW 3 — Selected row detail strip
        ═══════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="#1AFFFFFF"
                CornerRadius="4"
                Padding="12,8"
                Margin="0,6,0,0"
                MinHeight="44">
            <Grid>

                <TextBlock Text="Оберіть рядок, щоб побачити деталі перевірки."
                           Foreground="#44FFFFFF" FontSize="12"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRow}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedRow}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Foreground="#FF80CBC4" FontSize="12"
                               FontFamily="Consolas, Courier New">
                        <Run Text="{Binding SelectedRow.Name, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" (" Foreground="#44FFFFFF" /><Run Text="{Binding SelectedRow.KindLabel, Mode=OneWay}" /><Run Text=")" Foreground="#44FFFFFF" />
                        <Run Text="  |  Останнє підтвердження: " Foreground="#44FFFFFF" />
                        <Run Text="{Binding SelectedRow.LastConfirmedDisplay, Mode=OneWay}" />
                        <Run Text="  |  Розмір: " Foreground="#44FFFFFF" />
                        <Run Text="{Binding SelectedRow.LastSizeDisplay, Mode=OneWay}" />
                        <Run Text="  |  Зразків у baseline: " Foreground="#44FFFFFF" />
                        <Run Text="{Binding SelectedRow.SamplesDisplay, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock
                        Text="{Binding SelectedRow.LastError, Mode=OneWay}"
                        Foreground="#FFEF5350"
                        FontSize="12"
                        TextWrapping="Wrap"
                        MaxHeight="60"
                        Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRow.HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</UserControl>