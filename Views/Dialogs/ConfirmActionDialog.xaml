<UserControl
    x:Class="AdminConsole.Views.Dialogs.ConfirmActionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Width="400">

    <Border
        Background="#FF2C3E44"
        CornerRadius="8"
        Padding="28,24">
        <StackPanel>

            <!-- Icon + Title -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <materialDesign:PackIcon
                    Kind="AlertCircleOutline"
                    Width="26" Height="26"
                    Foreground="#FFFFC107"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="TitleBlock"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Body -->
            <TextBlock
                x:Name="BodyBlock"
                Foreground="#FFCFD8DC"
                FontSize="13"
                TextWrapping="Wrap"
                Margin="0,0,0,28"
                LineHeight="20" />

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <!-- Cancel button -->
                <Button
                    x:Name="CancelBtn"
                    Padding="16,8"
                    Margin="0,0,12,0"
                    Cursor="Hand"
                    Click="CancelBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="#22FFFFFF"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                                <!-- Content presenter renders Button.Content,
                                     which is set below as a TextBlock in the
                                     logical tree — accessible from code-behind. -->
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <!-- Named child lives in logical tree, reachable from code-behind -->
                    <TextBlock
                        Text="Cancel"
                        Foreground="#FFECEFF1"
                        FontSize="13" />
                </Button>

                <!-- Confirm button -->
                <Button
                    x:Name="ConfirmBtn"
                    Padding="16,8"
                    Cursor="Hand"
                    Click="ConfirmBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Background="#CCF44336"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#EEF44336" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFF44336" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <!-- This TextBlock IS in the logical tree and IS named —
                         code-behind can read and write its Text property. -->
                    <TextBlock
                        x:Name="ConfirmLabel"
                        Text="Confirm"
                        Foreground="White"
                        FontSize="13"
                        FontWeight="Medium" />
                </Button>

            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>